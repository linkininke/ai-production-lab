# 应用
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# false：不要求填写模型密钥，便于启动服务和运行不访问外网的测试。
# true：启动时检查 LLM_* 与 EMBEDDING_* 是否齐全。两者必须分别配置。
ENABLE_EXTERNAL_MODELS=false

# 对话模型。不要和下面的 Embedding 模型写成同一个配置项。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# 向量模型。更换模型后必须重建索引，不能和旧向量混用。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=64

CHROMA_PERSIST_DIR=./data/chroma
# 3 到 512 个字符：字母、数字、点、下划线、短横线，并且以字母或数字开头和结尾。
CHROMA_COLLECTION=knowledge_base

# 第一版按字符数切分，不是 Token 数。CHUNK_OVERLAP 必须小于 CHUNK_SIZE。
CHUNK_SIZE=800
CHUNK_OVERLAP=120

DEFAULT_TOP_K=5
MAX_TOP_K=20

# 问题本身的字符上限。上下文只限制检索到的资料，不把整篇文档塞进模型。
MAX_QUESTION_CHARS=2000
MAX_CONTEXT_CHARS=12000
# 留空表示不按距离截断。填写的是余弦距离上限：0 最近，数值越大越远，不是相似度。
RETRIEVAL_MAX_DISTANCE=

# 混合检索先各取一批候选，再按名次融合。不把向量距离和 BM25 分数相加。
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_FINAL_TOP_K=10
RRF_K=60

# 默认关闭。MockReranker 只用于测试，不能当作线上重排模型。
# 开启后请求 POST {RERANKER_BASE_URL}/rerank，分数只用服务返回的 relevance_score。
RERANKER_ENABLED=false
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT=60
RERANKER_CANDIDATE_TOP_K=20
RERANKER_FINAL_TOP_K=5

# 留空表示不估算费用。没有 Token 用量时，评测仍把 estimated_cost_usd 记为 null。
LLM_INPUT_PRICE_PER_1M=
LLM_OUTPUT_PRICE_PER_1M=
EMBEDDING_PRICE_PER_1M=
RERANKER_PRICE_PER_1K=

MAX_UPLOAD_SIZE_MB=10

# 评测集、样例语料和报告目录。报告是每次运行的结果，不要提交。
EVALUATION_DATASET_PATH=./data/evaluation/questions.json
EVALUATION_CORPUS_DIR=./data/evaluation/corpus
EVALUATION_REPORTS_DIR=./data/evaluation/reports

# 外部客户端遇到超时、网络错误或 429/5xx 时的额外重试次数。0 表示不重试，最大 3。
PROVIDER_MAX_RETRIES=2

# 评测预算。留空表示不限制。设置了 MAX_COST 但没有填写下面的 Token 和单价时，会在调用模型前停止。
EVALUATION_MAX_CASES=
EVALUATION_MAX_COST=
BUDGET_PROMPT_TOKENS=
BUDGET_COMPLETION_TOKENS=
BUDGET_EMBEDDING_TOKENS=

# 质量门和 SLO。留空表示不检查。下面是已经启用的门槛，相等算通过。
# Groundedness 使用 0 到 4 分，不是 0 到 1 的比例。
QUALITY_GATE_RECALL_AT_5=0.80
QUALITY_GATE_CITATION_VALIDITY=0.98
QUALITY_GATE_GROUNDEDNESS=3.5
QUALITY_GATE_P95_MS=3000
SLO_SUCCESS_RATE=0.99
SLO_P95_LATENCY_MS=3000
SLO_CITATION_VALIDITY=0.98

# 健康卡警告。留空表示不因为延迟、成本、质量下降或失败率把总状态降为警告。
# 比例用小数：0.33 表示相对基线上升超过 33%。质量下降用绝对差，0.05 表示超过 5 个百分点。
HEALTH_P95_INCREASE_RATIO=
HEALTH_COST_INCREASE_RATIO=
HEALTH_QUALITY_DROP=
HEALTH_FAILURE_RATE_MAXIMUM=

# mock：不调用模型，报告里的 Judge 分数为空，不能当成真实评测。
# llm：用上面的对话模型按量规打分。那仍是评测模型，不是标准答案，而且会消耗额度。
JUDGE_MODE=mock
JUDGE_MAX_RETRIES=1
